# SerpApi Configuration (Required for Live Search Mode)
# Get your free or paid API key at: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Google Gemini API Configuration (Required for AI-powered grounded evidence analysis)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Application Environment Mode: 'live' or 'demo'
# In 'live' mode without keys, the app gracefully prompts and offers Demo Mode.
NEXT_PUBLIC_APP_MODE=live

