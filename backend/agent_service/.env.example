SERPAPI_API_KEY=

# Google Gemini API Key (Required for AI Research Planning and Evidence Analysis)
# https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Service Port
PORT=8000
